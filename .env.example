# Optional OpenAI connection. M1/M2 inference runs locally without this key.
# Copy this file to .env, set your own API key, then restart Start.cmd.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_PROVIDER=OpenAI
# For Gemini: AI_PROVIDER=Gemini; create key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# For Ollama: AI_PROVIDER=Ollama; no key needed.
OLLAMA_MODEL=qwen3.5:4b
